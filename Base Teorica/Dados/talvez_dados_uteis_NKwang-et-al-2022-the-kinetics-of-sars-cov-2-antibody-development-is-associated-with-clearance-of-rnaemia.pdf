        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>longitudinal data modeling</rdf:li>
          <rdf:li>persistent SARS-CoV-2 plasma viremia</rdf:li>
          <rdf:li>system serology</rdf:li>
          <rdf:li>viremia</rdf:li>
          <rdf:li>humoral immune response</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li xml:lang="x-default">American Society for Microbiology</rdf:li>
        </rdf:Bag>
